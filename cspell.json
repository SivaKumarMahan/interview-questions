{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "dictionaries": [
    "software-terms",
    "aws",
    "k8s",
    "docker",
    "golang",
    "python",
    "bash",
    "powershell",
    "companies",
    "fullstack",
    "node",
    "npm",
    "sql",
    "terraform",
    "filetypes",
    "public-licenses"
  ],
  "ignorePaths": [
    ".git/**",
    "**/node_modules/**",
    "**/*.tf",
    "**/*.go",
    "**/*.yaml",
    "**/*.yml",
    "**/go.mod"
  ],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "HexValues",
    "UUID",
    "fencedCode",
    "inlineCode",
    "htmlCode",
    "markdownLinkTarget"
  ],
  "patterns": [
    {
      "name": "fencedCode",
      "pattern": "/^\\s*(`{3,}|~{3,})[\\s\\S]*?^\\s*\\1/gm"
    },
    {
      "name": "inlineCode",
      "pattern": "/`[^`\\n]+`/g"
    },
    {
      "name": "htmlCode",
      "pattern": "/<code>[\\s\\S]*?<\\/code>/g"
    },
    {
      "name": "markdownLinkTarget",
      "pattern": "/\\]\\([^)]*\\)/g"
    }
  ],
  "minWordLength": 4,
